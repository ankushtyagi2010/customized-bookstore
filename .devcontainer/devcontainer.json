{
  "name": "Customized Bookstore Dev",
  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "app-dev",
  "workspaceFolder": "/workspace",

  "shutdownAction": "stopCompose",

  // Mount host git config and SSH keys for seamless git operations
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ],

  // Features to add
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-spring-initializr",
        "vscjava.vscode-spring-boot-dashboard",
        "pivotal.vscode-boot-dev-pack",
        "gabrielbb.vscode-lombok",
        "mongodb.mongodb-vscode",
        "redhat.vscode-xml",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/opt/java/openjdk"
          }
        ],
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "maven.executable.path": "/usr/bin/mvn",
        "spring-boot.ls.java.home": "/opt/java/openjdk",
        "files.exclude": {
          "**/.classpath": true,
          "**/.project": true,
          "**/.settings": true,
          "**/.factorypath": true
        },
        // Git configuration
        "git.enabled": true,
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.postCommitCommand": "none",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "forwardPorts": [8080, 27017, 8081],
  "portsAttributes": {
    "8080": {
      "label": "Application",
      "onAutoForward": "notify"
    },
    "27017": {
      "label": "MongoDB"
    },
    "8081": {
      "label": "Mongo Express"
    }
  },

  "postCreateCommand": "mvn clean install -DskipTests",

  // Fix SSH key permissions after container starts
  "postStartCommand": "sh -c 'if [ -d ~/.ssh ]; then chmod 700 ~/.ssh && chmod 600 ~/.ssh/* 2>/dev/null || true; fi'",

  "remoteUser": "vscode"
}
