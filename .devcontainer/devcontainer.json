{
  "name": "Customized Bookstore Dev",
  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "app-dev",
  // Temporarily disabled - will re-enable when firewall is working
  // "runArgs": [
  //   "--cap-add=NET_ADMIN",
  //   "--cap-add=NET_RAW"
  // ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  "shutdownAction": "stopCompose",

  // Mount host SSH keys for seamless git operations
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached"
  ],

  // Features to add
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  // Configure git to use host credentials
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "GIT_EDITOR": "code --wait"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-spring-initializr",
        "vscjava.vscode-spring-boot-dashboard",
        "pivotal.vscode-boot-dev-pack",
        "gabrielbb.vscode-lombok",
        "mongodb.mongodb-vscode",
        "redhat.vscode-xml",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/opt/java/openjdk"
          }
        ],
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "maven.executable.path": "/usr/bin/mvn",
        "spring-boot.ls.java.home": "/opt/java/openjdk",
        "files.exclude": {
          "**/.classpath": true,
          "**/.project": true,
          "**/.settings": true,
          "**/.factorypath": true
        },
        // Git configuration
        "git.enabled": true,
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.postCommitCommand": "none",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },

  "forwardPorts": [8080, 27017, 8081],
  "portsAttributes": {
    "8080": {
      "label": "Application",
      "onAutoForward": "notify"
    },
    "27017": {
      "label": "MongoDB"
    },
    "8081": {
      "label": "Mongo Express"
    }
  },

  // Run after container is created for the first time
  "postCreateCommand": "bash -c 'mkdir -p /home/node/.m2 && chmod -R 755 /home/node/.m2 && mvn clean install -DskipTests && git config --global --add safe.directory /workspace'",

  // Start MongoDB and configure git after container starts
  "postStartCommand": "/usr/local/bin/start-mongodb.sh",

  // Run when attaching to an existing container
  "postAttachCommand": "bash -c '/usr/local/bin/start-mongodb.sh; git config --global --add safe.directory /workspace'",

  "remoteUser": "node"
}
